# Frontend (Vercel)
NEXT_PUBLIC_API_URL=https://api.example.org

# API / worker
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/genomic_agent
REDIS_URL=redis://HOST:6379/0
CORS_ORIGINS=https://web-rosy-sigma-48.vercel.app
JOB_EXECUTION_MODE=celery
ARTIFACT_STORAGE_PATH=/app/artifacts
# Set this when the production worker uses a signed container image.
ANALYSIS_CONTAINER_IMAGE=

# Personal DNA installer files on the API's private filesystem
PERSONAL_DNA_INSTALLER_DIR=/app/personal-dna-installers
# On Vercel, use private Supabase Storage instead of a mounted directory
PERSONAL_DNA_STORAGE_URL=
PERSONAL_DNA_STORAGE_KEY=
PERSONAL_DNA_STORAGE_BUCKET=personal-dna-installers
