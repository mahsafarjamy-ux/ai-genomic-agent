          {"tool": "Alevin-fry", "version": "0.10.0", "purpose": "Ultra-fast, memory-efficient", "recommended": false},
          {"tool": "kallisto|bustools", "version": "0.50.1", "purpose": "Fast pseudoalignment", "recommended": false}
        ],
        "qc_filtering": [
          {"tool": "Seurat", "version": "5.1.0", "language": "R", "docker": "satijalab/seurat:5.1.0", "recommended": true},
          {"tool": "Scanpy", "version": "1.10.0", "language": "Python", "docker": "quay.io/biocontainers/scanpy:1.10.0--pyhdfd78af_0", "recommended": true},
          {"tool": "scDblFinder", "version": "1.16.0", "language": "R", "purpose": "Doublet detection", "recommended": true},
          {"tool": "DoubletFinder", "version": "2.0.4", "language": "R", "purpose": "Doublet detection", "recommended": false}
        ],
        "normalization": [
          {"tool": "scran", "version": "1.30.0", "language": "R", "purpose": "Pooling-based normalization", "recommended": true},
          {"tool": "sctransform", "version": "0.4.1", "language": "R", "purpose": "Variance-stabilizing normalization", "recommended": true, "notes": "Now default in Seurat v5"}
        ],
        "integration_batch_correction": [
          {"tool": "Harmony", "version": "1.2.0", "language": "R", "purpose": "Fast integration", "recommended": true, "notes": "Best for large datasets"},
          {"tool": "scVI", "version": "1.1.0", "language": "Python", "purpose": "Variational autoencoder integration", "recommended": true, "notes": "Best for complex batch effects"},
          {"tool": "BBKNN", "version": "1.6.0", "language": "Python", "purpose": "Batch-balanced KNN", "recommended": false},
          {"tool": "Seurat CCA/RPCA", "version": "5.1.0", "language": "R", "purpose": "Canonical correlation integration", "recommended": false}
        ],
        "clustering": [
