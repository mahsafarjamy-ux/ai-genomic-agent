          {"tool": "BWA-MEM2", "version": "2.2.1", "recommended": false}
        ],
        "peak_calling": [
          {"tool": "MACS3", "version": "3.0.1", "docker": "quay.io/biocontainers/macs3:3.0.1--py310h4b81fae_0", "recommended": true, "notes": "Narrow peaks for TF; broad peaks for H3K27me3/H3K9me3"},
          {"tool": "SEACR", "version": "1.3", "purpose": "CUT&RUN / CUT&TAG peak calling", "recommended": true}
