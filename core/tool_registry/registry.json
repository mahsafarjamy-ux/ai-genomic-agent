{
  "version": "2.0.0",
  "last_updated": "2026-06-15",
  "categories": {
    "rnaseq": {
      "name": "Bulk RNA-seq",
      "description": "Transcriptome profiling from bulk tissue",
      "stages": {
        "qc": [
          {"tool": "FastQC", "version": "0.12.1", "purpose": "Raw read QC", "docker": "biocontainers/fastqc:v0.12.1_cv2", "recommended": true, "speed": "fast", "notes": "Always run first"},
          {"tool": "MultiQC", "version": "1.22", "purpose": "Aggregate QC reports", "docker": "quay.io/biocontainers/multiqc:1.22.3--pyhdfd78af_0", "recommended": true, "speed": "fast"}
        ],
        "trimming": [
          {"tool": "fastp", "version": "0.23.4", "purpose": "Adapter trimming + QC", "docker": "biocontainers/fastp:v0.23.4_cv1", "recommended": true, "speed": "fast", "notes": "Faster than Trimmomatic, auto-detects adapters"},
          {"tool": "Trimmomatic", "version": "0.39", "purpose": "Adapter trimming", "docker": "quay.io/biocontainers/trimmomatic:0.39--hdfd78af_2", "recommended": false, "notes": "Legacy; use fastp instead"}
        ],
        "alignment": [
          {"tool": "STAR", "version": "2.7.11a", "purpose": "Splice-aware alignment", "docker": "quay.io/biocontainers/star:2.7.11a--h0033a41_0", "recommended": true, "speed": "fast", "ram_gb": 32, "notes": "Best for human/mouse, handles novel junctions"},
          {"tool": "HISAT2", "version": "2.2.1", "purpose": "Splice-aware alignment, low RAM", "docker": "quay.io/biocontainers/hisat2:2.2.1--h87f3376_4", "recommended": false, "ram_gb": 8, "notes": "Use when RAM is limited"},
          {"tool": "Salmon", "version": "1.10.2", "purpose": "Quasi-alignment + quantification", "docker": "combinelab/salmon:1.10.2", "recommended": true, "speed": "very_fast", "notes": "No BAM output; best for DE only workflows"}
        ],
        "quantification": [
          {"tool": "featureCounts", "version": "2.0.6", "purpose": "Gene-level counts from BAM", "docker": "quay.io/biocontainers/subread:2.0.6--he4a0461_0", "recommended": true, "notes": "Part of Subread package"},
          {"tool": "HTSeq", "version": "2.0.5", "purpose": "Gene-level counts", "docker": "quay.io/biocontainers/htseq:2.0.5--py310h4b81fae_0", "recommended": false, "notes": "Slower than featureCounts"},
          {"tool": "kallisto", "version": "0.50.1", "purpose": "Pseudoalignment + quantification", "docker": "quay.io/biocontainers/kallisto:0.50.1--hdbdd923_1", "recommended": false, "notes": "Ultra-fast, isoform-level"}
        ],
        "differential_expression": [
          {"tool": "DESeq2", "version": "1.42.0", "language": "R", "purpose": "Differential gene expression", "conda": "bioconductor-deseq2", "recommended": true, "notes": "Best for bulk RNA-seq, handles overdispersion"},
          {"tool": "edgeR", "version": "4.0.14", "language": "R", "purpose": "Differential expression", "conda": "bioconductor-edger", "recommended": false, "notes": "Better for very small N"},
          {"tool": "limma-voom", "version": "3.58.0", "language": "R", "purpose": "Differential expression", "conda": "bioconductor-limma", "recommended": false, "notes": "Best for microarray or complex designs"}
        ],
        "pathway_analysis": [
          {"tool": "clusterProfiler", "version": "4.10.0", "language": "R", "purpose": "GO and KEGG enrichment", "conda": "bioconductor-clusterprofiler", "recommended": true},
          {"tool": "GSEA", "version": "4.3.3", "purpose": "Gene set enrichment analysis", "recommended": true, "notes": "Preranked GSEA avoids threshold issues"},
          {"tool": "fgsea", "version": "1.28.0", "language": "R", "purpose": "Fast GSEA", "conda": "bioconductor-fgsea", "recommended": true, "notes": "100x faster than GSEA"},
          {"tool": "STRING-db", "version": "12.0", "purpose": "Protein interaction networks", "api": "https://string-db.org/api", "recommended": true}
        ],
        "isoform_analysis": [
          {"tool": "SUPPA2", "version": "2.3", "purpose": "Differential splicing", "docker": "quay.io/biocontainers/suppa:2.3--py37_0", "recommended": true},
          {"tool": "rMATS", "version": "4.3.0", "purpose": "Alternative splicing analysis", "docker": "xinglab/rmats:v4.3.0", "recommended": true}
        ]
      }
    },
    "wgs": {
      "name": "Whole Genome Sequencing",
      "description": "Germline or somatic variant discovery from WGS",
      "stages": {
        "qc": [
          {"tool": "FastQC", "version": "0.12.1", "docker": "biocontainers/fastqc:v0.12.1_cv2", "recommended": true},
          {"tool": "Fastp", "version": "0.23.4", "docker": "biocontainers/fastp:v0.23.4_cv1", "recommended": true},
          {"tool": "Picard CollectWgsMetrics", "version": "3.1.1", "docker": "broadinstitute/picard:3.1.1", "purpose": "Coverage metrics", "recommended": true},
          {"tool": "mosdepth", "version": "0.3.8", "docker": "quay.io/biocontainers/mosdepth:0.3.8--hd299d5a_0", "purpose": "Fast depth calculation", "recommended": true}
        ],
        "alignment": [
          {"tool": "BWA-MEM2", "version": "2.2.1", "docker": "quay.io/biocontainers/bwa-mem2:2.2.1--hd03093a_5", "recommended": true, "speed": "fast", "notes": "2-3x faster than BWA-MEM"},
          {"tool": "Parabricks", "version": "4.3", "purpose": "GPU-accelerated BWA+GATK", "recommended": false, "notes": "Requires NVIDIA GPU; 50x speedup"}
        ],
        "preprocessing": [
          {"tool": "GATK MarkDuplicates", "version": "4.5.0", "docker": "broadinstitute/gatk:4.5.0.0", "recommended": true},
          {"tool": "GATK BQSR", "version": "4.5.0", "docker": "broadinstitute/gatk:4.5.0.0", "recommended": true}
        ],
        "germline_variant_calling": [
          {"tool": "GATK HaplotypeCaller", "version": "4.5.0", "docker": "broadinstitute/gatk:4.5.0.0", "recommended": true, "notes": "GVCF mode for joint genotyping"},
          {"tool": "DeepVariant", "version": "1.6.1", "docker": "google/deepvariant:1.6.1", "recommended": true, "notes": "DL-based; best accuracy on Illumina short reads"},
          {"tool": "GATK GenotypeGVCFs", "version": "4.5.0", "docker": "broadinstitute/gatk:4.5.0.0", "purpose": "Joint genotyping", "recommended": true}
        ],
        "somatic_variant_calling": [
          {"tool": "Mutect2", "version": "4.5.0", "docker": "broadinstitute/gatk:4.5.0.0", "recommended": true, "notes": "Best for tumor-normal pairs"},
          {"tool": "Strelka2", "version": "2.9.10", "docker": "quay.io/biocontainers/strelka:2.9.10--h9ee0642_1", "recommended": true, "notes": "Fast, good for SNV+indel"},
          {"tool": "VarScan2", "version": "2.4.4", "docker": "quay.io/biocontainers/varscan:2.4.4--hdfd78af_2", "recommended": false}
        ],
        "variant_annotation": [
          {"tool": "VEP", "version": "111", "docker": "ensemblorg/ensembl-vep:release_111", "recommended": true, "notes": "Ensembl; comprehensive, slow"},
          {"tool": "ANNOVAR", "version": "2023", "purpose": "Fast variant annotation", "recommended": true, "notes": "Faster than VEP; needs license for some databases"},
          {"tool": "SnpEff", "version": "5.2", "docker": "quay.io/biocontainers/snpeff:5.2--hdfd78af_0", "recommended": false},
          {"tool": "ClinVar", "purpose": "Clinical significance lookup", "api": "https://eutils.ncbi.nlm.nih.gov/", "recommended": true},
          {"tool": "gnomAD", "version": "4.1", "purpose": "Population allele frequencies", "api": "https://gnomad.broadinstitute.org/api", "recommended": true},
          {"tool": "ACMG ClassifyCNV", "purpose": "ACMG 5-tier variant classification", "recommended": true}
        ],
        "cnv": [
          {"tool": "PURPLE", "version": "4.0", "docker": "gridss/purple:latest", "purpose": "CNV + purity + ploidy (tumor)", "recommended": true},
          {"tool": "CNVkit", "version": "0.9.10", "docker": "etal/cnvkit:0.9.10", "recommended": true, "notes": "Works for both WGS and WES"},
          {"tool": "GATK gCNV", "version": "4.5.0", "docker": "broadinstitute/gatk:4.5.0.0", "recommended": false, "notes": "Best for germline CNV in cohorts"}
        ],
        "structural_variants": [
          {"tool": "DELLY", "version": "1.2.6", "docker": "quay.io/biocontainers/delly:1.2.6--ha41ced6_0", "recommended": true, "notes": "Best for deletions/inversions/translocations"},
          {"tool": "Manta", "version": "1.6.0", "docker": "quay.io/biocontainers/manta:1.6.0--py27_0", "recommended": true, "notes": "Fast, good for insertions"},
          {"tool": "GRIDSS", "version": "2.13.2", "docker": "gridss/gridss:2.13.2", "recommended": true, "notes": "Best for complex rearrangements"},
          {"tool": "Parliament2", "version": "0.1.11", "docker": "dnanexus/parliament2:0.1.11", "purpose": "SV ensemble caller", "recommended": true},
          {"tool": "SURVIVOR", "version": "1.0.7", "purpose": "Merge SV calls from multiple callers", "recommended": true},
          {"tool": "shatterseek", "version": "0.4", "language": "R", "purpose": "Chromothripsis detection", "recommended": false},
          {"tool": "Sniffles2", "version": "2.3.3", "docker": "quay.io/biocontainers/sniffles:2.3.3--pyhdfd78af_0", "purpose": "Long-read SV (ONT/PacBio)", "recommended": true}
        ]
      }
    },
    "wes": {
      "name": "Whole Exome Sequencing",
      "description": "Exome capture + variant calling",
      "notes": "Same core pipeline as WGS; add capture QC steps",
      "stages": {
        "qc": [
          {"tool": "FastQC", "version": "0.12.1", "docker": "biocontainers/fastqc:v0.12.1_cv2", "recommended": true},
          {"tool": "Picard CalculateHsMetrics", "version": "3.1.1", "docker": "broadinstitute/picard:3.1.1", "purpose": "Capture efficiency metrics", "recommended": true},
          {"tool": "mosdepth", "version": "0.3.8", "docker": "quay.io/biocontainers/mosdepth:0.3.8--hd299d5a_0", "recommended": true}
        ],
        "alignment": [{"tool": "BWA-MEM2", "version": "2.2.1", "recommended": true}],
        "variant_calling": [
          {"tool": "GATK HaplotypeCaller", "version": "4.5.0", "recommended": true, "notes": "Use --intervals to restrict to capture regions"},
          {"tool": "DeepVariant", "version": "1.6.1", "docker": "google/deepvariant:1.6.1", "recommended": true},
          {"tool": "Mutect2", "version": "4.5.0", "recommended": true, "notes": "For somatic calls from tumor WES"}
        ],
        "cnv": [
          {"tool": "CNVkit", "version": "0.9.10", "recommended": true, "notes": "Designed for exome capture"},
          {"tool": "ExomeCNV", "version": "1.4", "language": "R", "recommended": false}
        ]
      }
    },
    "scrnaseq": {
