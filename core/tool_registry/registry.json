    "atacseq": {
      "name": "ATAC-seq",
      "description": "Chromatin accessibility profiling",
      "stages": {
        "qc_trimming": [
          {"tool": "FastQC", "version": "0.12.1", "recommended": true},
          {"tool": "fastp", "version": "0.23.4", "recommended": true, "params": {"min_length": 25, "detect_adapter": true}}
        ],
        "alignment": [
          {"tool": "Bowtie2", "version": "2.5.3", "recommended": true, "params": {"--very-sensitive": true, "--no-mixed": true, "--no-discordant": true, "-X": 2000}},
          {"tool": "Remove mitochondrial reads", "tool_name": "SAMtools", "notes": "chrM reads are artifact"}
        ],
        "peak_calling": [
          {"tool": "MACS3", "version": "3.0.1", "recommended": true, "params": {"--nomodel": true, "--shift": -75, "--extsize": 150, "--keep-dup": "all"}},
          {"tool": "Genrich", "version": "0.6.1", "purpose": "ATAC-specific peak caller", "recommended": false}
        ],
        "footprinting": [
          {"tool": "TOBIAS", "version": "0.16.0", "docker": "quay.io/biocontainers/tobias:0.16.0--py310hd9da9d5_0", "purpose": "TF footprinting from ATAC", "recommended": true},
          {"tool": "HINT-ATAC", "version": "0.17.3", "purpose": "TF footprinting", "recommended": false}
        ],
        "advanced": [
          {"tool": "ArchR", "version": "1.0.3", "language": "R", "purpose": "Full ATAC-seq analysis framework", "recommended": true},
          {"tool": "SnapATAC2", "version": "2.6.0", "language": "Python", "purpose": "Single-cell ATAC + multiome", "recommended": true},
          {"tool": "Signac", "version": "1.13.0", "language": "R", "purpose": "scATAC integrated with Seurat", "recommended": true}
        ]
      }
    },
