          {"tool": "CellTypist", "version": "1.6.2", "language": "Python", "purpose": "ML-based cell type prediction", "recommended": true, "notes": "Great for immune cells"},
          {"tool": "scType", "version": "1.0", "language": "R", "purpose": "Marker-based annotation", "recommended": true}
        ],
        "trajectory_pseudotime": [
          {"tool": "Monocle3", "version": "1.3.6", "language": "R", "purpose": "Cell trajectory inference", "recommended": true},
          {"tool": "scVelo", "version": "0.3.2", "language": "Python", "purpose": "RNA velocity", "recommended": true, "notes": "Requires spliced/unspliced counts"},
          {"tool": "Palantir", "version": "1.3.3", "language": "Python", "recommended": false}
        ],
        "cell_communication": [
          {"tool": "CellChat", "version": "2.1.1", "language": "R", "purpose": "Cell-cell communication", "recommended": true},
          {"tool": "NicheNet", "version": "2.1.4", "language": "R", "purpose": "Ligand-target prediction", "recommended": true},
          {"tool": "LIANA+", "version": "1.1.0", "language": "Python", "purpose": "Multi-method communication", "recommended": true}
        ],
        "gene_regulatory_networks": [
          {"tool": "SCENIC+", "version": "1.0.2", "language": "Python", "purpose": "TF regulatory networks (RNA+ATAC)", "recommended": true},
          {"tool": "pySCENIC", "version": "0.12.1", "language": "Python", "purpose": "TF networks from scRNA only", "recommended": true}
        ]
      }
