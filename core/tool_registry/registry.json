          {"tool": "HOMER annotatePeaks", "version": "4.11", "docker": "quay.io/biocontainers/homer:4.11--pl5262h7d875b9_4", "recommended": true},
          {"tool": "GREAT", "purpose": "Genomic region enrichment of annotations", "api": "http://great.stanford.edu/", "recommended": true}
